generator client {
  provider = "prisma-client-js"
}

// PostgreSQL is the single supported provider (GF-3). PostGIS is enabled by the
// committed `enable_postgis` migration and is required for the Geofence spatial
// column below.
//
// Prisma 7 no longer accepts `url` here: the connection string is read from the
// DATABASE_URL environment variable by prisma.config.ts (for the CLI/Migrate)
// and by PrismaService's driver adapter (for the running application).
datasource db {
  provider = "postgresql"
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// Where one device stood relative to one circle at one observation (GF-6).
//
// Two explicit values rather than a boolean: this is a wire-visible domain
// state, and `"state": "INSIDE"` cannot be misread the way `"inside": true`
// beside a `transition` field can. The boundary belongs to INSIDE, because GF-5
// decides containment with `ST_Distance(...) <= "radiusMeters"`.
enum GeofenceContainmentState {
  INSIDE
  OUTSIDE
}

// How the containment state of one device changed for one geofence (GF-6).
//
// BASELINE_* is what the first accepted observation for a device/geofence pair
// produces. It is deliberately distinct from ENTER/EXIT: nothing is known about
// where the device was before, so claiming a crossing would be an invention.
// Reactivating a geofence returns the pair to that unknown-previous condition
// (see GeofenceDeviceState), so it baselines again rather than crossing.
enum GeofenceTransition {
  BASELINE_INSIDE
  BASELINE_OUTSIDE
  ENTER
  EXIT
  STAY_INSIDE
  STAY_OUTSIDE
}

// Authenticated identity. Login identity is the canonicalized (trimmed +
// lowercased) email, enforced unique at the database layer. Only the bcrypt
// password hash is stored; plaintext passwords are never persisted or logged.
//
// `email` is bounded to the RFC 5321 limit already enforced by the auth DTOs
// (EMAIL_MAX_LENGTH). `passwordHash` is deliberately left unbounded text: its
// length is an artifact of the hashing algorithm, not an API contract, so
// pinning it would break a future algorithm change.
model User {
  id           String       @id @default(cuid())
  email        String       @unique @db.VarChar(254)
  passwordHash String
  memberships  Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A tenant is the unit of data ownership and isolation. Every geofence belongs
// to exactly one tenant, and access is only ever granted through a validated
// membership.
model Tenant {
  id             String          @id @default(cuid())
  name           String          @db.VarChar(120)
  memberships    Membership[]
  geofences      Geofence[]
  trackedDevices TrackedDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Explicit user<->tenant relationship. Keeping membership separate from the
// user record lets the authorization model grow (multiple tenants per user,
// roles) later without redesigning identity. The (userId, tenantId) pair is
// unique so a user cannot join the same tenant twice.
model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Geofence {
  id           String  @id @default(cuid())
  tenantId     String
  name         String  @db.VarChar(120)
  description  String? @db.VarChar(1000)
  latitude     Float
  longitude    Float
  radiusMeters Float
  isActive     Boolean @default(true)

  // Canonical spatial representation of the circle center, as
  // geography(Point, 4326) with longitude as X and latitude as Y.
  //
  // Prisma has no native PostGIS type, so this is declared as Unsupported: it is
  // never selected or written by Prisma Client, and the scalar latitude/longitude
  // fields above remain the application-facing read/write contract.
  //
  // The column is `GENERATED ALWAYS AS (...) STORED` (see the
  // `geofence_spatial_constraints` migration). PostgreSQL computes it from
  // latitude/longitude and rejects any attempt to write it directly, so the
  // scalar and spatial representations cannot diverge. It is declared optional
  // here only because Prisma Client refuses to create rows for models with a
  // required Unsupported field; the database itself enforces NOT NULL.
  centerPoint Unsupported("geography(Point, 4326)")?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alertEvents  AlertEvent[]
  deviceStates GeofenceDeviceState[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Referenced by GeofenceDeviceState's composite foreign key, for the same
  // reason TrackedDevice carries one: PostgreSQL itself then rejects a state row
  // whose tenant disagrees with its geofence's tenant.
  @@unique([id, tenantId])
  @@index([tenantId])
  // Declares the GiST index created by the geofence_spatial_constraints
  // migration so Prisma knows it exists and does not try to drop it. The name
  // is mapped explicitly to match the migration.
  @@index([centerPoint], type: Gist, map: "Geofence_centerPoint_gist_idx")
}

// One durable geofence alert event (GF-7).
//
// GF-7 reuses this pre-existing table rather than introducing a competing one.
// It was declared, unused, by the GF-1 baseline; every column it already had is
// still here, and the phase adds only the provenance a crossing needs. A second
// alert table would have split "what happened" across two places for no reason
// beyond the shape of a model nothing had ever written.
//
// An alert row is an immutable statement that ONE observation moved ONE device
// across the boundary of ONE geofence, in ONE direction. Nothing in it is
// supplied by a caller: every identity below is copied from rows the database
// itself resolved while advancing GF-6 transition state, inside that same
// transaction. `transition` is constrained to ENTER and EXIT by a CHECK (see the
// `geofence_alert_events` migration) — a baseline, a stay, a stale observation
// and a retired state are not crossings. The CHECK only restricts labels;
// application classification and its transaction establish spatial semantics.
//
// Deliberately absent: coordinates, the measured distance, the geofence radius
// and any device or geofence snapshot. All of them are already reachable through
// the foreign keys below, and a copy would be a second answer that can go stale.
// Also absent is anything about delivery — no channel, recipient, attempt count
// or sent-at column exists, because GF-7 records the alarm and delivers nothing.
//
// Legacy columns from the unused GF-1 declaration are reconciled conservatively
// rather than removed:
//   * `severity` and `status` keep their pre-existing defaults. GF-7 never reads,
//     advances or exposes them; acknowledgement and resolution are a later phase.
//   * `eventType` and `message` become nullable; `source` was already nullable.
//     All three are left NULL. The
//     authoritative crossing type is the typed `transition` column, so writing it
//     a second time as free text would create a value that can disagree with it,
//     and inventing a human-readable `message` would be fabricating a
//     notification template for a phase that sends nothing. Relaxing NOT NULL on
//     two unused text columns removes no guarantee anything depended on: the
//     row's meaning is carried entirely by typed columns and foreign keys, which
//     this phase tightens.
//   * `latitude` and `longitude` stay nullable and unwritten, with their existing
//     range CHECK constraints intact.
model AlertEvent {
  id String @id @default(cuid())

  // Provenance (GF-7). Together these are the alert: whose device, which
  // geofence, which observation, and in which direction it crossed.
  tenantId              String
  trackedDeviceId       String
  geofenceId            String
  sourceLocationEventId String

  // The crossing this alert records. Constrained to ENTER/EXIT in the database.
  transition GeofenceTransition

  // The source's own observation instant, copied from the location event that
  // owns the crossing — never a server clock, and never a caller-supplied value
  // taken on trust. `timestamptz(3)` matches LocationEvent.observedAt and
  // GeofenceDeviceState.lastObservedAt exactly, so one instant survives every
  // hop. `createdAt` below is the separate, server-owned bookkeeping time and
  // keeps the plain `timestamp` type every other bookkeeping column uses.
  observedAt DateTime @db.Timestamptz(3)

  // Pre-existing GF-1 columns; see the note above.
  eventType String?
  severity  AlertSeverity @default(MEDIUM)
  status    AlertStatus   @default(OPEN)
  message   String?
  source    String?
  latitude  Float?
  longitude Float?

  // Every reference is composite on (id, tenantId), the same posture GF-6 gave
  // GeofenceDeviceState: PostgreSQL itself rejects an alert whose tenant
  // disagrees with its geofence, device or source event, so a cross-tenant alert
  // cannot be stored even by code that bypasses the service layer. The GF-1
  // single-column geofence foreign key is replaced by the composite one in the
  // `geofence_alert_events` migration — it enforces everything the old key did,
  // and tenant agreement as well.
  //
  // Deletion still cascades, and cannot reach across tenants: each referenced row
  // is proven to belong to this alert's own tenant by the very same key.
  geofence            Geofence      @relation(fields: [geofenceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trackedDevice       TrackedDevice @relation(fields: [trackedDeviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  sourceLocationEvent LocationEvent @relation(fields: [sourceLocationEventId, tenantId], references: [id, tenantId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The deduplication boundary, and the conflict target of the single
  // conflict-safe insert in geofence-alert.query.ts.
  //
  // One accepted crossing is one (tenant, device, geofence, source observation,
  // direction). Retrying a request, replaying the event, racing two identical
  // submissions and repairing a half-finished ingestion all resolve to that same
  // tuple, so the database — not an application pre-check — collapses them into
  // one row.
  //
  // Direction is an explicit component of crossing identity. A normal geometry
  // edit does not let equal or older observations advance again: the strict
  // observation ordering still applies.
  //
  // Named explicitly because Prisma's generated name for five columns is
  // truncated at PostgreSQL's 63-byte identifier limit and would be unreadable in
  // catalog assertions.
  @@unique([tenantId, trackedDeviceId, geofenceId, sourceLocationEventId, transition], map: "AlertEvent_crossing_key")
  // Reading back the alerts one ingestion produced, and the source-event cascade,
  // are both (tenantId, sourceLocationEventId) lookups. Tenant/geofence access
  // and the geofence cascade are the second index. Tenant/device lookups need no
  // index of their own: they are the leading columns of the unique key above.
  @@index([tenantId, sourceLocationEventId])
  @@index([tenantId, geofenceId])
  // The GF-8 read path: one tenant's alerts, newest observation first, ties
  // broken by id. Every other index on this table leads with a column the list
  // endpoint does not filter on by default, so without this one the unfiltered
  // list is a scan of the tenant's entire alert history followed by a sort — the
  // cost of which grows with everything the tenant has ever recorded, not with
  // the page returned. Declared descending in both components so the ordering is
  // satisfied by a forward scan of exactly this index.
  //
  // It is not a second copy of any existing index: `AlertEvent_crossing_key`
  // leads with (tenantId, trackedDeviceId) and carries no observation time, and
  // neither `(tenantId, sourceLocationEventId)` nor `(tenantId, geofenceId)` can
  // order by `observedAt`. Those three still serve the filtered lookups they were
  // created for; this one serves the ordering.
  @@index([tenantId, observedAt(sort: Desc), id(sort: Desc)])
}

// A tenant-owned location source (GF-4). This is the minimum device foundation
// the ingestion path requires: an event can only be accepted for a device that
// the caller's tenant already owns. Enrollment workflows, per-device secrets and
// device lifecycle management are deliberately not part of GF-4.
//
// `deviceKey` is the stable identifier the source reports about itself. It is
// unique *within* a tenant, so two tenants may legitimately use the same key for
// unrelated devices without colliding or learning about each other. Internal
// relational identity stays on the cuid `id`; `deviceKey` is never used to look
// a device up across tenants.
model TrackedDevice {
  id        String  @id @default(cuid())
  tenantId  String
  deviceKey String  @db.VarChar(128)
  name      String  @db.VarChar(120)
  isActive  Boolean @default(true)

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationEvents LocationEvent[]
  geofenceStates GeofenceDeviceState[]
  alertEvents    AlertEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same external key may exist in separate tenants; it may not repeat
  // inside one.
  @@unique([tenantId, deviceKey])
  // Referenced by LocationEvent's composite foreign key below. PostgreSQL
  // requires a unique constraint on the referenced column pair, and declaring it
  // here is what makes a device/event tenant mismatch structurally impossible.
  @@unique([id, tenantId])
  @@index([tenantId])
}

// One location observation reported by a tracked device (GF-4).
//
// Rows are append-only: nothing in the API updates a location event, so the
// model carries a single server-side `receivedAt` timestamp rather than the
// createdAt/updatedAt pair used by the mutable models above. An `updatedAt`
// column would advertise a mutability the ingestion contract does not have.
//
// GF-4 records observations only. No containment evaluation, transition state or
// alert linkage exists here — those belong to a later phase and are not
// pre-declared as unused columns.
model LocationEvent {
  id              String @id @default(cuid())
  tenantId        String
  trackedDeviceId String

  // Client-supplied idempotency key. Uniqueness is scoped to
  // (tenantId, trackedDeviceId, eventKey) — see the @@unique below.
  eventKey String @db.VarChar(200)

  // `observedAt` is the moment the source reports the fix was taken;
  // `receivedAt` is when this server accepted it. Both are `timestamptz` so the
  // stored value is an unambiguous absolute instant regardless of the session
  // time zone of whatever process reads it. (The pre-existing bookkeeping
  // columns elsewhere in this schema are plain `timestamp`; for a value supplied
  // by an external source with its own clock and offset, preserving the instant
  // exactly is part of the contract, so the more precise type is used here.)
  observedAt DateTime @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  latitude       Float
  longitude      Float
  accuracyMeters Float

  // Canonical spatial representation of the observation, as
  // geography(Point, 4326) with longitude as X and latitude as Y — the same
  // convention and SRID as Geofence.centerPoint.
  //
  // As with Geofence, this is `GENERATED ALWAYS AS (...) STORED` (see the
  // `location_event_spatial_constraints` migration): PostgreSQL computes it from
  // the scalar coordinates and refuses direct writes, so the two representations
  // cannot diverge. It is optional here only because Prisma Client will not
  // create rows for a model with a required Unsupported field; the database
  // enforces NOT NULL.
  observedPoint Unsupported("geography(Point, 4326)")?

  // Composite foreign key. Referencing (id, tenantId) rather than id alone means
  // PostgreSQL itself rejects any row whose tenant disagrees with its device's
  // tenant — the ownership invariant is structural, not merely enforced by the
  // service layer. Tenant deletion still cascades: Tenant -> TrackedDevice ->
  // LocationEvent.
  trackedDevice TrackedDevice @relation(fields: [trackedDeviceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  // Back-relations for GeofenceDeviceState.lastLocationEvent (GF-6) and
  // AlertEvent.sourceLocationEvent (GF-7). Location events stay append-only;
  // nothing here makes them mutable.
  geofenceStates GeofenceDeviceState[]
  alertEvents    AlertEvent[]

  // Idempotency boundary. Including tenantId is redundant with the composite
  // foreign key above, but it keeps the constraint (and every replay lookup that
  // uses it) tenant-qualified in its own right, so one tenant's event key can
  // never collide with — or disclose — another's.
  @@unique([tenantId, trackedDeviceId, eventKey])
  // Referenced by GeofenceDeviceState's composite foreign key, so a state row
  // cannot cite a source event belonging to a different tenant.
  @@unique([id, tenantId])
  // Supports the tenant-scoped device timeline that later phases read.
  @@index([tenantId, trackedDeviceId, observedAt])
}

// The transition state of one device against one geofence (GF-6).
//
// This is the whole of GF-6's persistence: exactly enough to decide, for the
// next accepted observation, whether the device crossed a boundary. There is no
// transition history table and no alert, notification or delivery record — GF-7
// owns durable alert-event generation, and pre-declaring its tables here would
// only add unused columns.
//
// Identity is (tenantId, trackedDeviceId, geofenceId) and it is the primary key,
// so the database — not the service layer — guarantees one row per triple. That
// is also the conflict target the single atomic upsert statement in
// geofence-transition.query.ts infers, which is what makes concurrent
// observations impossible to resolve into two contradictory rows. There is no
// surrogate cuid because the row has no identity of its own to name, and because
// every write to this table is raw SQL, which cannot invoke Prisma's `cuid()`.
//
// Both foreign keys are composite on (id, tenantId). A state row therefore
// cannot reference a geofence, device or source event outside its own tenant:
// cross-tenant collision is rejected by PostgreSQL, not merely avoided by the
// query predicates (which also carry the tenant).
//
// Deleting a geofence, a device or a tenant removes the state that referred to
// it. Deactivating a geofence removes it too (GeofencesService.update), which is
// what makes the first observation after a reactivation a new BASELINE_* rather
// than a fabricated ENTER or EXIT.
//
// No rounded distance is stored. Distance is a presentation value derived from
// the geography columns on demand; persisting it would create a second,
// staler answer to a question the database already answers exactly.
model GeofenceDeviceState {
  tenantId        String
  trackedDeviceId String
  geofenceId      String

  // Where the device stood at the last accepted observation.
  state GeofenceContainmentState

  // The classification that last accepted observation produced. Stored, not
  // merely returned, for two reasons: the ON CONFLICT update computes it from
  // the row it is actually overwriting, which is what makes classification
  // atomic with advancement rather than a read-then-write race; and replaying
  // the same location event can then answer with the identical classification
  // instead of a second, differently-worded description of one crossing.
  lastTransition GeofenceTransition

  // Which observation this state came from, and when that observation was taken
  // according to the source. `lastObservedAt` is the canonical ordering value —
  // never a server receipt time — and ties on it are broken by
  // `lastLocationEventId`. Together they are the total order that stops an
  // out-of-order or replayed event from regressing state.
  lastLocationEventId String
  lastObservedAt      DateTime @db.Timestamptz(3)

  trackedDevice     TrackedDevice @relation(fields: [trackedDeviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  geofence          Geofence      @relation(fields: [geofenceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  lastLocationEvent LocationEvent @relation(fields: [lastLocationEventId, tenantId], references: [id, tenantId], onDelete: Cascade)

  // Written explicitly by the upsert statement: `@updatedAt` is a Prisma Client
  // behavior, and no Prisma Client write ever creates or advances these rows.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, trackedDeviceId, geofenceId])
  // Retiring the state of a geofence (deactivation) and reading a device's
  // states are both tenant-scoped; the primary key already serves the latter.
  @@index([tenantId, geofenceId])
  @@index([tenantId, lastLocationEventId])
}
