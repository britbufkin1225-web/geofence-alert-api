# Copy to .env and fill in local values. Never commit a real .env.

# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL + PostGIS, required)
# ----------------------------------------
# The application refuses to start unless DATABASE_URL is a postgresql:// (or
# postgres://) connection string. There is no SQLite fallback and no default.
#
# These POSTGRES_* values configure the local Compose database in
# docker-compose.yml; DATABASE_URL is what the application and Prisma CLI read.
# Keep them consistent. POSTGRES_PASSWORD has no default in Compose on purpose —
# the stack will not start until you set one here.
POSTGRES_USER=geofence
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=geofence
POSTGRES_PORT=5432
DATABASE_URL="postgresql://geofence:replace-with-a-local-development-password@localhost:5432/geofence?schema=public"

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Security
API_KEY=change-this-development-api-key

# Authentication (REQUIRED)
# The application fails to start if JWT_SECRET is missing or shorter than 32
# characters. Generate a strong, random value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit a real secret. This placeholder is intentionally not a valid one.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime (optional; default 1h). Accepts values like 15m, 1h, 7d.
JWT_EXPIRES_IN=1h

# Geofence Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=100
MAX_GEOFENCE_RADIUS_METERS=5000

# Logging
LOG_LEVEL=debug

# Disposable integration-test database (optional)
# -----------------------------------------------
# `npm run test:db` starts its own throwaway PostGIS container from
# docker-compose.test.yml and builds its own DATABASE_URL; it never reads the
# values above. Override only the host port if 55433 is already taken.
# TEST_DB_PORT=55433
